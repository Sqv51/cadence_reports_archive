@file(run_genus.tcl) 110: if {[file exists $VCD_FILE]} {
    puts "INFO: Reading VCD activity data from $VCD_FILE"
    
    # Use 'read_vcd' (Standard Genus Command)
    # -vcd_module: Path in the VCD file (Testbench/DUT)
    # -module:     Path in the Genus design (Top Module)
    if {[catch {read_vcd -vcd_module vcd_tb/u_dut -module $DESIGN -static $VCD_FILE} err]} {
        puts "WARNING: VCD import failed: $err"
        puts "Falling back to static probability for power estimation."
    } else {
        puts "SUCCESS: VCD loaded. Power report will be dynamic."
    }
} else {
    puts "WARNING: VCD file not found at $VCD_FILE. Skipping dynamic power."
}
