catch {setNanoRouteMode -quiet -route_use_auto_via "true"}
catch {setNanoRouteMode -quiet -route_with_si_driven true}
catch {setNanoRouteMode -quiet -route_with_si_post_route_fix false}
catch {setNanoRouteMode -quiet -route_with_timing_driven true}
catch {setNanoRouteMode -quiet -route_with_via_in_pin "1:1"}
catch {setNanoRouteMode -quiet -route_with_via_only_for_stdcell_pin "1:1"}
catch {setNanoRouteMode -quiet -timingEngine ".timing_file_2286967_d6c360d1-d97a-4362-ab92-6fcde742eb0a.tif.gz"}

catch { setIlmMode -keepHighFanoutPorts true -keepLoopBack false -keepInstInSdc false -keepFlatten true }
catch { setUsefulSkewMode -opt_skew_eco_route false }
catch { setDelayCalMode -enable_hier_save_restore_flow false }
catch { setDelayCalMode -enable_high_fanout true }
catch { setDelayCalMode -enable_ideal_seq_async_pins false }
catch { setDelayCalMode -eng_enablePrePlacedFlow false }
